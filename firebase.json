{
  "hosting": {
    "site": "alexbetpro",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "fetch-data.js",
      "alerts.js",
      "resumen.js",
      "alerts-seen.json",
      "tenis-elo.js",
      "historial.js",
      "push-send.js",
      "node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}